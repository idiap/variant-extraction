#!/bin/bash

#SBATCH --cpus-per-gpu 4
#SBATCH --mem 80G
#SBATCH -p gpu
#SBATCH -G h100
#SBATCH -t 08:00:00
#SBATCH -A MetaboLinkAI

echo "running with:"

nvidia-smi

chmod +x train_and_evaluate
./train_and_evaluate